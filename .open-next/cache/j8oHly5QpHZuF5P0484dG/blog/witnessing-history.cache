\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-arrow-left w-4 h-4 group-hover:-translate-x-1 transition-transform\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1l729n\",{\"d\":\"m12 19-7-7 7-7\"}],[\"$\",\"path\",\"x3x0zl\",{\"d\":\"M19 12H5\"}],\"$undefined\"]}],\"Back to Terminal\"]}]}],[\"$\",\"header\",null,{\"className\":\"mb-16\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-6\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-terminal w-4 h-4 text-slate-gray\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"baeox8\",{\"d\":\"M12 19h8\"}],[\"$\",\"path\",\"1yngyt\",{\"d\":\"m4 17 6-6-6-6\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"className\":\"text-xs font-mono text-slate-gray uppercase tracking-widest\",\"children\":\"LOG_READER: EXECUTION_SUCCESS\"}]]}],[\"$\",\"h1\",null,{\"className\":\"text-4xl md:text-6xl font-bold tracking-tighter mb-8 leading-tight\",\"children\":\"The Recent Gen Z Revolution: A Student’s Perspective from Nepal\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-8 text-slate-gray font-mono text-xs uppercase tracking-[0.2em] border-y border-slate-gray/20 py-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-calendar w-4 h-4\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1cmpym\",{\"d\":\"M8 2v4\"}],[\"$\",\"path\",\"4m81vk\",{\"d\":\"M16 2v4\"}],[\"$\",\"rect\",\"1hopcy\",{\"width\":\"18\",\"height\":\"18\",\"x\":\"3\",\"y\":\"4\",\"rx\":\"2\"}],[\"$\",\"path\",\"8toen8\",{\"d\":\"M3 10h18\"}],\"$undefined\"]}],\"2025.10.05\"]}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-clock w-4 h-4\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"mmk7yg\",{\"d\":\"M12 6v6l4 2\"}],\"$undefined\"]}],\"7 min read\"]}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"w-2 h-2 rounded-full bg-pure-white animate-pulse\"}],\"Status: Finalized\"]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"prose prose-invert prose-slate max-w-none    prose-headings:font-bold prose-headings:tracking-tighter prose-headings:uppercase   prose-p:text-pure-white/80 prose-p:leading-relaxed prose-p:text-lg   prose-code:text-pure-white prose-code:bg-dim-gray prose-code:px-1 prose-code:rounded   prose-pre:bg-dim-gray prose-pre:border prose-pre:border-slate-gray/30   font-mono\",\"children\":[[\"$\",\"h1\",\"h1-0\",{\"children\":\"The Recent Gen Z Revolution: A Student’s Perspective from Nepal\"}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"children\":[\"As a student in Nepal, I often find myself scrolling through news, social media threads, and discussion forums where one phrase appears again and again: \",[\"$\",\"em\",\"em-0\",{\"children\":\"the Gen Z revolution\"}],\". Whether it is about politics, climate change, mental health, or education reform, young people across the globe seem to be redefining what it means to participate in society. From my corner of the world, this “revolution” feels less like a sudden uprising and more like a steady, determined shift in mindset.\"]}],\"\\n\",\"$Le\",\"\\n\",\"$Lf\",\"\\n\",\"$L10\",\"\\n\",\"$L11\",\"\\n\",\"$L12\",\"\\n\",\"$L13\",\"\\n\",\"$L14\",\"\\n\",\"$L15\",\"\\n\",\"$L16\",\"\\n\",\"$L17\",\"\\n\",\"$L18\",\"\\n\",\"$L19\",\"\\n\",\"$L1a\",\"\\n\",\"$L1b\",\"\\n\",\"$L1c\",\"\\n\",\"$L1d\",\"\\n\",\"$L1e\",\"\\n\",\"$L1f\",\"\\n\",\"$L20\",\"\\n\",\"$L21\",\"\\n\",\"$L22\",\"\\n\",\"$L23\",\"\\n\",\"$L24\",\"\\n\",\"$L25\",\"\\n\",\"$L26\",\"\\n\",\"$L27\",\"\\n\",\"$L28\",\"\\n\",\"$L29\",\"\\n\",\"$L2a\"]}],\"$L2b\"]}]\ne:[\"$\",\"hr\",\"hr-0\",{}]\nf:[\"$\",\"h2\",\"h2-0\",{\"children\":\"A Digital Generation with a Global Voice\"}]\n10:[\"$\",\"p\",\"p-1\",{\"children\":\"Generation Z—those born roughly between the late 1990s and early 2010s—are the first true digital natives. Platforms like TikTok, Instagram, and X have become more than entertainment spaces; they are tools for activism, education, and mobilization.\"}]\n11:[\"$\",\"p\",\"p-2\",{\"children\":\"From Nepal, I can witness global conversations in real time. When students in the United States protest tuition hikes, when climate activists rally in Europe, or when movements emerge in Asia, we see it instantly. This connectivity has reduced the distance between Kathmandu and the rest of the world. Ideas travel faster than ever before.\"}]\n12:[\"$\",\"hr\",\"hr-1\",{}]\n13:[\"$\",\"h2\",\"h2-1\",{\"children\":\"Political Awareness and Civic Engagement\"}]\n14:[\"$\",\"p\",\"p-3\",{\"children\":\"In Nepal, young people are increasingly vocal about corruption, governance, and accountability. While older generations may sometimes criticize Gen Z for being “too outspoken,” I see it as a sign of engagement rather than rebellion for its own sake. Many students discuss constitutional rights, democratic values, and transparency with surprising depth.\"}]\n15:[\"$\",\"p\",\"p-4\",{\"children\":\"We grew up in the aftermath of the civil conflict and during Nepal’s transition to a federal democratic republic. Because of this, politics does not feel abstract to us. It feels personal. We want stable institutions, merit-based opportunities, and leaders who genuinely represent the people. Social media has given us a platform to question decisions and demand better standards.\"}]\n16:[\"$\",\"hr\",\"hr-2\",{}]\n17:[\"$\",\"h2\",\"h2-2\",{\"children\":\"Mental Health and Breaking Taboos\"}]\n18:[\"$\",\"p\",\"p-5\",{\"children\":\"Another important aspect of the Gen Z shift is openness about mental health. In Nepal, conversations about anxiety, depression, and academic pressure were once considered taboo. Today, students are more willing to talk about stress, burnout, and emotional well-being.\"}]\n19:[\"$\",\"p\",\"p-6\",{\"children\":\"This openness is revolutionary in its own way. It challenges traditional norms that equate silence with strength. By speaking up, students are slowly changing cultural attitudes. Universities and schools are also beginning to recognize the importance of counseling services and support systems.\"}]\n1a:[\"$\",\"hr\",\"hr-3\",{}]\n1b:[\"$\",\"h2\",\"h2-3\",{\"children\":\"Climate Consciousness\"}]\n1c:[\"$\",\"p\",\"p-7\",{\"children\":\"Nepal, being home to the Himalayas, is especially vulnerable to climate change. Melting glaciers, unpredictable monsoons, and air pollution in cities like Kathmandu are daily reminders of environmental urgency. Inspired by global climate activists, many Nepali students are advocating for sustainability, tree-planting campaigns, and reduced plastic use.\"}]\n1d:[\"$\",\"p\",\"p-8\",{\"children\":\"For us, climate activism is not just symbolic—it is about protecting our own mountains, rivers, and future livelihoods.\"}]\n1e:[\"$\",\"hr\",\"hr-4\",{}]\n1f:[\"$\",\"h2\",\"h2-4\",{\"children\":\"Education and Career Aspirations\"}]\n20:[\"$\",\"p\",\"p-9\",{\"children\":\"Gen Z students in Nepal are also redefining career paths. Unlike previous generations who prioritized traditional professions like medicine, engineering, or government service, many young people now explore entrepreneurship, digital freelancing, and technology-based careers.\"}]\n21:[\"$\",\"p\",\"p-10\",{\"children\":\"Remote work and online learning platforms have broadened our horizons. A student in Kathmandu can now learn coding from international instructors, start an online business, or collaborate on global projects. This independence fosters confidence and creativity.\"}]\n22:[\"$\",\"hr\",\"hr-5\",{}]\n23:[\"$\",\"h2\",\"h2-5\",{\"children\":\"Challenges and Criticisms\"}]\n24:[\"$\",\"p\",\"p-11\",{\"children\":\"Of course, the Gen Z movement is not without criticism. Some argue that online activism is superficial or that our generation lacks patience and resilience. There is also the issue of misinformation spreading rapidly through digital platforms.\"}]\n25:[\"$\",\"p\",\"p-12\",{\"children\":\"However, every generation faces its own growing pains. The key difference is that Gen Z’s struggles are highly visible because they unfold online. Mistakes and debates happen in public view.\"}]\n26:[\"$\",\"hr\",\"hr-6\",{}]\n27:[\"$\",\"h2\",\"h2-6\",{\"children\":\"Conclusion: A Quiet but Determined Transformation\"}]\n28:[\"$\",\"p\",\"p-13\",{\"children\":\"From my perspective as a student in Nepal, the so-called Gen Z revolution is less about chaos and more about consciousness. It is about questioning outdated systems, valuing inclusivity, prioritizing mental health, and demanding accountability.\"}]\n29:[\"$\",\"p\",\"p-14\",{\"children\":\"We may not always march in the streets, but we write, post, organize, and discuss. We are connected, aware, and increasingly confident in our voices. In a country like Nepal—rich in culture yet facing modern challenges—this new mindset could become a powerful force for positive change.\"}]\n2a:[\"$\",\"p\",\"p-15\",{\"children\":\"The revolution is not loud all the time. Sometimes, it is simply a student deciding not to stay silent anymore.\"}]\n2b:[\"$\",\"footer\",null,{\"className\":\"mt-24 pt-12 border-t border-slate-gray/20 flex flex-col items-center gap-12\",\"children\":[[\"$\",\"$Ld\",null,{\"href\":\"/\",\"className\":\"inline-flex items-center gap-3 px-8 py-4 border border-slate-gray/30 hover:border-pure-white hover:bg-white/5 transition-all font-mono text-xs uppercase tracking-[0.3em] group\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-arrow-left w-4 h-4 group-hover:-translate-x-1 transition-transform\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1l729n\",{\"d\":\"m12 19-7-7 7-7\"}],[\"$\",\"path\",\"x3x0zl\",{\"d\":\"M19 12H5\"}],\"$undefined\"]}],\"Back to Terminal\"]}],[\"$\",\"p\",null,{\"className\":\"text-[10px] text-slate-gray font-mono uppercase tracking-[0.5em]\",\"children\":\"End of Transmission // [EOF]\"}]]}]\n9:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n2c:I[27201,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"IconMark\"]\n7:null\nb:[[\"$\",\"title\",\"0\",{\"children\":\"Neekson Shrestha | Creative Technologist\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"High-performance portfolio for Neekson Shrestha - Premium Developer IDE Experience.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico?favicon.0b3bf435.ico\",\"sizes\":\"256x256\",\"type\":\"image/x-icon\"}],[\"$\",\"$L2c\",\"3\",{}]]\n","/blog/$d$slug/__PAGE__":"1:\"$Sreact.fragment\"\n2:I[22016,[\"/_next/static/chunks/7c92e96509cd355e.js\"],\"\"]\n23:I[97367,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"OutletBoundary\"]\n24:\"$Sreact.suspense\"\n0:{\"buildId\":\"j8oHly5QpHZuF5P0484dG\",\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"article\",null,{\"className\":\"min-h-screen bg-obsidian text-pure-white px-8 md:px-24 py-24 max-w-5xl mx-auto selection:bg-pure-white selection:text-obsidian\",\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-16\",\"children\":[\"$\",\"$L2\",null,{\"href\":\"/\",\"className\":\"inline-flex items-center gap-3 px-6 py-3 border border-slate-gray/30 hover:border-pure-white hover:bg-white/5 transition-all font-mono text-[10px] uppercase tracking-widest group\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-arrow-left w-4 h-4 group-hover:-translate-x-1 transition-transform\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1l729n\",{\"d\":\"m12 19-7-7 7-7\"}],[\"$\",\"path\",\"x3x0zl\",{\"d\":\"M19 12H5\"}],\"$undefined\"]}],\"Back to Terminal\"]}]}],[\"$\",\"header\",null,{\"className\":\"mb-16\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-6\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-terminal w-4 h-4 text-slate-gray\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"baeox8\",{\"d\":\"M12 19h8\"}],[\"$\",\"path\",\"1yngyt\",{\"d\":\"m4 17 6-6-6-6\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"className\":\"text-xs font-mono text-slate-gray uppercase tracking-widest\",\"children\":\"LOG_READER: EXECUTION_SUCCESS\"}]]}],[\"$\",\"h1\",null,{\"className\":\"text-4xl md:text-6xl font-bold tracking-tighter mb-8 leading-tight\",\"children\":\"The Recent Gen Z Revolution: A Student’s Perspective from Nepal\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-8 text-slate-gray font-mono text-xs uppercase tracking-[0.2em] border-y border-slate-gray/20 py-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-calendar w-4 h-4\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1cmpym\",{\"d\":\"M8 2v4\"}],[\"$\",\"path\",\"4m81vk\",{\"d\":\"M16 2v4\"}],[\"$\",\"rect\",\"1hopcy\",{\"width\":\"18\",\"height\":\"18\",\"x\":\"3\",\"y\":\"4\",\"rx\":\"2\"}],[\"$\",\"path\",\"8toen8\",{\"d\":\"M3 10h18\"}],\"$undefined\"]}],\"2025.10.05\"]}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-clock w-4 h-4\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"mmk7yg\",{\"d\":\"M12 6v6l4 2\"}],\"$undefined\"]}],\"7 min read\"]}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"w-2 h-2 rounded-full bg-pure-white animate-pulse\"}],\"Status: Finalized\"]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"prose prose-invert prose-slate max-w-none    prose-headings:font-bold prose-headings:tracking-tighter prose-headings:uppercase   prose-p:text-pure-white/80 prose-p:leading-relaxed prose-p:text-lg   prose-code:text-pure-white prose-code:bg-dim-gray prose-code:px-1 prose-code:rounded   prose-pre:bg-dim-gray prose-pre:border prose-pre:border-slate-gray/30   font-mono\",\"children\":[[\"$\",\"h1\",\"h1-0\",{\"children\":\"The Recent Gen Z Revolution: A Student’s Perspective from Nepal\"}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"children\":[\"As a student in Nepal, I often find myself scrolling through news, social media threads, and discussion forums where one phrase appears again and again: \",[\"$\",\"em\",\"em-0\",{\"children\":\"the Gen Z revolution\"}],\". Whether it is about politics, climate change, mental health, or education reform, young people across the globe seem to be redefining what it means to participate in society. From my corner of the world, this “revolution” feels less like a sudden uprising and more like a steady, determined shift in mindset.\"]}],\"\\n\",\"$L3\",\"\\n\",\"$L4\",\"\\n\",\"$L5\",\"\\n\",\"$L6\",\"\\n\",\"$L7\",\"\\n\",\"$L8\",\"\\n\",\"$L9\",\"\\n\",\"$La\",\"\\n\",\"$Lb\",\"\\n\",\"$Lc\",\"\\n\",\"$Ld\",\"\\n\",\"$Le\",\"\\n\",\"$Lf\",\"\\n\",\"$L10\",\"\\n\",\"$L11\",\"\\n\",\"$L12\",\"\\n\",\"$L13\",\"\\n\",\"$L14\",\"\\n\",\"$L15\",\"\\n\",\"$L16\",\"\\n\",\"$L17\",\"\\n\",\"$L18\",\"\\n\",\"$L19\",\"\\n\",\"$L1a\",\"\\n\",\"$L1b\",\"\\n\",\"$L1c\",\"\\n\",\"$L1d\",\"\\n\",\"$L1e\",\"\\n\",\"$L1f\"]}],\"$L20\"]}],[\"$L21\"],\"$L22\"]}],\"loading\":null,\"isPartial\":false}\n3:[\"$\",\"hr\",\"hr-0\",{}]\n4:[\"$\",\"h2\",\"h2-0\",{\"children\":\"A Digital Generation with a Global Voice\"}]\n5:[\"$\",\"p\",\"p-1\",{\"children\":\"Generation Z—those born roughly between the late 1990s and early 2010s—are the first true digital natives. Platforms like TikTok, Instagram, and X have become more than entertainment spaces; they are tools for activism, education, and mobilization.\"}]\n6:[\"$\",\"p\",\"p-2\",{\"children\":\"From Nepal, I can witness global conversations in real time. When students in the United States protest tuition hikes, when climate activists rally in Europe, or when movements emerge in Asia, we see it instantly. This connectivity has reduced the distance between Kathmandu and the rest of the world. Ideas travel faster than ever before.\"}]\n7:[\"$\",\"hr\",\"hr-1\",{}]\n8:[\"$\",\"h2\",\"h2-1\",{\"children\":\"Political Awareness and Civic Engagement\"}]\n9:[\"$\",\"p\",\"p-3\",{\"children\":\"In Nepal, young people are increasingly vocal about corruption, governance, and accountability. While older generations may sometimes criticize Gen Z for being “too outspoken,” I see it as a sign of engagement rather than rebellion for its own sake. Many students discuss constitutional rights, democratic values, and transparency with surprising depth.\"}]\na:[\"$\",\"p\",\"p-4\",{\"children\":\"We grew up in the aftermath of the civil conflict and during Nepal’s transition to a federal democratic republic. Because of this, politics does not feel abstract to us. It feels personal. We want stable institutions, merit-based opportunities, and leaders who genuinely represent the people. Social media has given us a platform to question decisions and demand better standards.\"}]\nb:[\"$\",\"hr\",\"hr-2\",{}]\nc:[\"$\",\"h2\",\"h2-2\",{\"children\":\"Mental Health and Breaking Taboos\"}]\nd:[\"$\",\"p\",\"p-5\",{\"children\":\"Another important aspect of the Gen Z shift is openness about mental health. In Nepal, conversations about anxiety, depression, and academic pressure were once considered taboo. Today, students are more willing to talk about stress, burnout, and emotional well-being.\"}]\ne:[\"$\",\"p\",\"p-6\",{\"children\":\"This openness is revolutionary in its own way. It challenges traditional norms that equate silence with strength. By speaking up, students are slowly changing cultural attitudes. Universities and schools are also beginning to recognize the importance of counseling services and support systems.\"}]\nf:[\"$\",\"hr\",\"hr-3\",{}]\n10:[\"$\",\"h2\",\"h2-3\",{\"children\":\"Climate Consciousness\"}]\n11:[\"$\",\"p\",\"p-7\",{\"children\":\"Nepal, being home to the Himalayas, is especially vulnerable to climate change. Melting glaciers, unpredictable monsoons, and air pollution in cities like Kathmandu are daily reminders of environmental urgency. Inspired by global climate activists, many Nepali students are advocating for sustainability, tree-planting campaigns, and reduced plastic use.\"}]\n12:[\"$\",\"p\",\"p-8\",{\"children\":\"For us, climate activism is not just symbolic—it is about protecting our own mountains, rivers, and future livelihoods.\"}]\n13:[\"$\",\"hr\",\"hr-4\",{}]\n14:[\"$\",\"h2\",\"h2-4\",{\"children\":\"Education and Career Aspirations\"}]\n15:[\"$\",\"p\",\"p-9\",{\"children\":\"Gen Z students in Nepal are also redefining career paths. Unlike previous generations who prioritized traditional professions like medicine, engineering, or government service, many young people now explore entrepreneurship, digital freelancing, and technology-based careers.\"}]\n16:[\"$\",\"p\",\"p-10\",{\"children\":\"Remote work and online learning platforms have broadened our horizons. A student in Kathmandu can now learn coding from international instructors, start an online business, or collaborate on global projects. This independence fosters confidence and creativity.\"}]\n17:[\"$\",\"hr\",\"hr-5\",{}]\n18:[\"$\",\"h2\",\"h2-5\",{\"children\":\"Challenges and Criticisms\"}]\n19:[\"$\",\"p\",\"p-11\",{\"children\":\"Of course, the Gen Z movement is not without criticism. Some argue that online activism is superficial or that our generation lacks patience and resilience. There is also the issue of misinformation spreading rapidly through digital platforms.\"}]\n1a:[\"$\",\"p\",\"p-12\",{\"children\":\"However, every generation faces its own growing pains. The key difference is that Gen Z’s struggles are highly visible because they unfold online. Mistakes and debates happen in public view.\"}]\n1b:[\"$\",\"hr\",\"hr-6\",{}]\n1c:[\"$\",\"h2\",\"h2-6\",{\"children\":\"Conclusion: A Quiet but Determined Transformation\"}]\n1d:[\"$\",\"p\",\"p-13\",{\"children\":\"From my perspective as a student in Nepal, the so-called Gen Z revolution is less about chaos and more about consciousness. It is about questioning outdated systems, valuing inclusivity, prioritizing mental health, and demanding accountability.\"}]\n1e:[\"$\",\"p\",\"p-14\",{\"children\":\"We may not always march in the streets, but we write, post, organize, and discuss. We are connected, aware, and increasingly confident in our voices. In a country like Nepal—rich in culture yet facing modern challenges—this new mindset could become a powerful force for positive change.\"}]\n1f:[\"$\",\"p\",\"p-15\",{\"children\":\"The revolution is not loud all the time. Sometimes, it is simply a student deciding not to stay silent anymore.\"}]\n20:[\"$\",\"footer\",null,{\"className\":\"mt-24 pt-12 border-t border-slate-gray/20 flex flex-col items-center gap-12\",\"children\":[[\"$\",\"$L2\",null,{\"href\":\"/\",\"className\":\"inline-flex items-center gap-3 px-8 py-4 border border-slate-gray/30 hover:border-pure-white hover:bg-white/5 transition-all font-mono text-xs uppercase tracking-[0.3em] group\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-arrow-left w-4 h-4 group-hover:-translate-x-1 transition-transform\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1l729n\",{\"d\":\"m12 19-7-7 7-7\"}],[\"$\",\"path\",\"x3x0zl\",{\"d\":\"M19 12H5\"}],\"$undefined\"]}],\"Back to Terminal\"]}],[\"$\",\"p\",null,{\"className\":\"text-[10px] text-slate-gray font-mono uppercase tracking-[0.5em]\",\"children\":\"End of Transmission // [EOF]\"}]]}]\n21:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/7c92e96509cd355e.js\",\"async\":true}]\n22:[\"$\",\"$L23\",null,{\"children\":[\"$\",\"$24\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@25\"}]}]\n25:null\n","/blog/$d$slug":"1:\"$Sreact.fragment\"\n2:I[39756,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"default\"]\n3:I[37457,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"default\"]\n0:{\"buildId\":\"j8oHly5QpHZuF5P0484dG\",\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L3\",null,{}]}]]}],\"loading\":null,\"isPartial\":false}\n","/blog":"1:\"$Sreact.fragment\"\n2:I[39756,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"default\"]\n3:I[37457,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"default\"]\n0:{\"buildId\":\"j8oHly5QpHZuF5P0484dG\",\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L3\",null,{}]}]]}],\"loading\":null,\"isPartial\":false}\n","/_index":"1:\"$Sreact.fragment\"\n2:I[39756,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"default\"]\n3:I[37457,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"default\"]\n:HL[\"/_next/static/chunks/d285fe86b50701ec.css\",\"style\"]\n0:{\"buildId\":\"j8oHly5QpHZuF5P0484dG\",\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/d285fe86b50701ec.css\",\"precedence\":\"next\"}]],[\"$\",\"html\",null,{\"lang\":\"en\",\"className\":\"dark scroll-smooth\",\"children\":[\"$\",\"body\",null,{\"className\":\"jetbrains_mono_7072